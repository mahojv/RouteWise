# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

# Database (PostgreSQL + PostGIS)
POSTGRES_USER=routewise
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=routewise
DATABASE_URL=postgresql://routewise:CHANGE_ME@localhost:5432/routewise

# Routing Engine (OSRM / OpenRouteService / Mock)
ROUTING_PROVIDER=osrm
OSRM_URL=http://localhost:5000
ORS_URL=http://localhost:8080
ORS_API_KEY=

# Geocoding Service (Nominatim / Mock)
GEOCODING_PROVIDER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=RouteWise/1.0 (contact@routewise.app)

# INEGI Sakbe API
INEGI_SAKBE_API_KEY=YOUR_INEGI_SAKBE_API_KEY

# Caching & Rate Limiting
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
