# RouteWise Mobile Environment Variables
# Copy to .env or .env.local for Expo development/production

# API Base URL for RouteWise Backend:
# - Production (Cloudflare Tunnel): https://api.<MI_DOMINIO>
# - Android Emulator: http://10.0.2.2:3000
# - iOS Simulator: http://localhost:3000
# - Physical device (LAN): http://<YOUR_LOCAL_IP>:3000
EXPO_PUBLIC_API_URL=https://api.<MI_DOMINIO>
